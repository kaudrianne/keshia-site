---
const links = [
  { href: '/work', label: 'Work' },
  { href: '/projects', label: 'Projects' },
  { href: '/off-the-clock', label: 'Off the clock' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
---
<header class="nav">
  <div class="wrap row">
    <a href="/" class="mark" aria-label="Home">
      <img class="logo" src="/favicon.svg" alt="" width="24" height="24" />Keshia Gunawan
    </a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; flex-wrap: wrap; }
  .mark {
    font-family: var(--font-display); font-weight: 600; color: var(--ink);
    text-decoration: none; display: flex; align-items: center; gap: 10px;
  }
  .logo { width: 24px; height: 24px; flex: none; }
  nav { display: flex; gap: clamp(12px, 3vw, 28px); flex-wrap: wrap; }
  nav a { color: var(--ink-soft); text-decoration: none; font-size: .95rem; padding: 4px 0; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--accent-bright); }
  @media (max-width: 560px) {
    .row { padding-top: 10px; padding-bottom: 10px; }
    nav { width: 100%; justify-content: space-between; }
    nav a { font-size: .88rem; }
  }
</style>
