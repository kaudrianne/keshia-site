---
import { contact } from '../data/site';
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap row">
    <p class="label">Last stop for now: New York · © {year} Keshia Gunawan</p>
    <p class="links">
      <a href={`mailto:${contact.email}`}>Email</a>
      <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href="/Keshia_Gunawan_Resume.pdf" target="_blank">Résumé</a>
    </p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); padding: 32px 0; margin-top: 40px; }
  .row { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: center; }
  .row p { margin: 0; }
  .links { display: flex; gap: 20px; }
</style>
