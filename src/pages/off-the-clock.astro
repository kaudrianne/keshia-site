---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { food } from '../data/food';
import { contact } from '../data/site';

// ── Photos (plus a resized 1600px version for the full-screen view)
const photos = await Promise.all(
  (await getCollection('photos')).map(async (p) => ({
    ...p,
    full: (await getImage({ src: p.data.image, width: 1600 })).src,
  })),
);

// ── Espresso log. brews.json is oldest first; the list shows newest first.
const chrono = (await getCollection('brews')).map((b) => b.data);
const brews = [...chrono].reverse();
const latest = chrono[chrono.length - 1];
const roasteries = new Set(chrono.map((b) => b.roastery)).size;
const ratio = (b: { dose_g: number; yield_g: number }) => `1:${(b.yield_g / b.dose_g).toFixed(1)}`;
const fmtDate = (s?: string) =>
  s ? new Date(s + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Early';

// Grind setting over time (fewer clicks = finer), oldest → newest
const withClicks = chrono.filter((b) => b.clicks !== undefined);
const cMin = Math.min(...withClicks.map((b) => b.clicks!)), cMax = Math.max(...withClicks.map((b) => b.clicks!));
const W = 260, H = 60, P = 8;
const pts = withClicks.map((b, i) => {
  const x = withClicks.length > 1 ? P + (i * (W - 2 * P)) / (withClicks.length - 1) : W / 2;
  const y = cMax === cMin ? H / 2 : P + ((cMax - b.clicks!) / (cMax - cMin)) * (H - 2 * P);
  return [x, y];
});
const path = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');

// ── Food
const countryMax = Math.max(...food.byCountry.map((c) => c.value));
const favorites = food.favorites
  .map((f) => ({ ...f, items: f.items.filter((i) => !i.startsWith('TODO')) }))
  .filter((f) => f.items.length > 0);
---
<Base title="Off the clock" description="Street photography, a daily home-brew log, and 556 restaurants reviewed.">
  <section class="wrap intro">
    <p class="label">The human side</p>
    <h1>Off the clock</h1>
    <p class="lede">Street photos from three cities, a coffee habit with a spreadsheet attached, and a restaurant log that got out of hand.</p>
    <nav class="jump" aria-label="Sections">
      <a href="#street">Street</a><a href="#brew-log">Brew log</a><a href="#food">Food</a>
    </nav>
  </section>

  <!-- STREET PHOTOGRAPHY -->
  <section id="street" class="section">
    <div class="wrap">
      <p class="label">Contact sheet</p>
      <h2>Street</h2>
      <p class="lede">Jakarta, Chicago, New York, and wherever I’m eating next.</p>
      <a class="ig" href={contact.instagram.url} target="_blank" rel="noopener">More on Instagram @{contact.instagram.handle} →</a>
      <div class="sheet reveal">
        {photos.map((p, i) => (
          <button class="frame" type="button" data-full={p.full} data-cap={`${p.data.caption} · ${p.data.place}, ${p.data.year}`}>
            <Image src={p.data.image} alt={p.data.caption} width={640} />
            <span class="fno">{String(i + 1).padStart(2, '0')}A</span>
            <span class="where">{p.data.place} · {p.data.year}</span>
          </button>
        ))}
      </div>
    </div>
    <dialog id="lightbox">
      <form method="dialog"><button class="close" aria-label="Close">×</button></form>
      <img alt="" />
      <p class="cap"></p>
    </dialog>
  </section>

  <!-- BREW LOG -->
  <section id="brew-log" class="section">
    <div class="wrap">
      <p class="label">Trial, error, notes</p>
      <h2>Espresso log</h2>
      <p class="lede">I pull espresso at home and write down what went wrong. This is that notebook.</p>

      <div class="brew-stats reveal">
        <div class="card"><span class="label">Shots logged</span><span class="num">{chrono.length}</span></div>
        <div class="card"><span class="label">Roasteries tried</span><span class="num">{roasteries}</span></div>
        <div class="card">
          <span class="label">Current recipe</span>
          <span class="num sm">{latest.dose_g}g → {latest.yield_g}g</span>
          <span class="sub">{ratio(latest)}{latest.clicks !== undefined && ` · ${latest.clicks} clicks`}</span>
        </div>
        <div class="card spark">
          <span class="label">Dialing in: grind</span>
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Grind setting went from ${withClicks[0]?.clicks} to ${latest.clicks} clicks`}>
            <path d={path} />
            {pts.map(([x, y]) => <circle cx={x} cy={y} r="3.5" />)}
          </svg>
          <span class="sub">{withClicks[0]?.clicks} → {withClicks[withClicks.length - 1]?.clicks} clicks, going finer</span>
        </div>
      </div>

      <ol class="brews">
        {brews.map((b) => (
          <li class="brew">
            <span class="date label">{fmtDate(b.date)}</span>
            <div class="what">
              <strong>{b.roastery}</strong>{b.beans && ` · ${b.beans}`}
              <div class="recipe label">
                {b.dose_g}g in · {b.yield_g}g out · {ratio(b)}
                {b.clicks !== undefined && ` · ${b.grinder ? b.grinder + ' ' : ''}${b.clicks} clicks`}
                {b.preinfusion_s !== undefined && ` · ${b.preinfusion_s}s pre-infusion`}
                {b.shot_s !== undefined && ` · ${b.shot_s}s shot`}
              </div>
              {b.note && <p class="note">{b.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FOOD -->
  <section id="food" class="section">
    <div class="wrap">
      <p class="label">Logged on Beli</p>
      <h2>Food</h2>
      <p class="lede">I review the meals I care about. My camera roll says I’ve eaten at about twice as many.</p>
      <a class="ig" href={contact.foodInstagram.url} target="_blank" rel="noopener">Follow the food account @{contact.foodInstagram.handle} →</a>

      <div class="food-big reveal">
        <div><span class="num">{food.restaurants}</span><span class="label">restaurants</span></div>
        <div><span class="num">{food.cities}</span><span class="label">cities</span></div>
        <div><span class="num">{food.cuisines}</span><span class="label">cuisines</span></div>
      </div>

      <div class="food-grid reveal">
        <div class="card">
          <h3>Where</h3>
          {food.byCountry.map((c) => (
            <div class="bar-row">
              <span>{c.label}</span>
              <span class="track"><span class="fill" style={`width:${(c.value / countryMax) * 100}%`}></span></span>
              <span class="val">{c.value}</span>
            </div>
          ))}
        </div>
        <div class="card">
          <h3>What I keep coming back to</h3>
          {food.topCuisines.map((c, i) => (
            <div class="rank"><span class="label">#{i + 1}</span><strong>{c.label}</strong><span class="val">{c.value}</span></div>
          ))}
        </div>
        <div class="card nyc">
          <h3>New York so far</h3>
          <p><span class="num">{food.nycRestaurants}</span> restaurants since {food.nycSince}</p>
          <p><span class="num">{food.nycCoffeeShops}</span> coffee shops benchmarked on one iced vanilla latte</p>
        </div>
      </div>

      {favorites.length > 0 && (
        <div class="favs reveal">
          {favorites.map((f) => (
            <div><h3>{f.list}</h3><ol>{f.items.map((i) => <li>{i}</li>)}</ol></div>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  document.querySelectorAll<HTMLButtonElement>('.frame').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!dlg) return;
      const img = dlg.querySelector('img')!;
      img.src = btn.dataset.full || '';
      img.alt = btn.querySelector('img')?.alt || '';
      dlg.querySelector('.cap')!.textContent = btn.dataset.cap || '';
      dlg.showModal();
    });
  });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .intro { padding-top: clamp(40px, 8vw, 88px); padding-bottom: 8px; }
  .jump { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
  .jump a { text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: .35em 1em; color: var(--ink); font-size: .9rem; }
  .jump a:hover { border-color: var(--accent-bright); }
  .section { scroll-margin-top: 60px; }
  .ig { display: inline-block; font-weight: 500; text-decoration: none; margin-top: -4px; }
  .ig:hover { text-decoration: underline; }

  /* contact sheet */
  .sheet {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px;
    margin-top: 28px; padding: 14px; background: #161616; border-radius: 8px;
  }
  .frame {
    position: relative; padding: 0; border: 0; background: none; cursor: zoom-in;
    aspect-ratio: 4 / 3; overflow: hidden; border-radius: 3px;
  }
  .frame img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.15); transition: filter .3s, transform .5s; }
  .frame:hover img { filter: none; transform: scale(1.03); }
  .fno, .where {
    position: absolute; font-family: var(--font-mono); font-size: .7rem; color: #f2c14e;
    text-shadow: 0 1px 2px #000; letter-spacing: .05em;
  }
  .fno { left: 8px; top: 6px; }
  .where { left: 8px; bottom: 6px; color: #fff; opacity: 0; transition: opacity .2s; }
  .frame:hover .where, .frame:focus-visible .where { opacity: 1; }
  dialog { border: 0; padding: 0; background: transparent; max-width: min(92vw, 1100px); }
  dialog::backdrop { background: rgba(0, 0, 0, .85); }
  dialog img { max-height: 80vh; width: auto; margin: 0 auto; border-radius: 4px; }
  dialog .cap { color: #eee; text-align: center; margin-top: 10px; font-size: .9rem; }
  .close { position: absolute; right: 4px; top: -44px; background: none; border: 0; color: #fff; font-size: 2rem; cursor: pointer; }

  /* brew log */
  .brew-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 28px 0; }
  .brew-stats .card { display: flex; flex-direction: column; gap: 6px; padding: 18px; }
  .num { font-family: var(--font-display); font-weight: 700; font-size: 2.2rem; line-height: 1; color: var(--crema); }
  .num.sm { font-size: 1.4rem; }
  .sub { font-size: .85rem; color: var(--ink-soft); }
  .spark svg { width: 100%; height: auto; }
  .spark path { fill: none; stroke: var(--crema); stroke-width: 2.5; stroke-linejoin: round; }
  .spark circle { fill: var(--bg); stroke: var(--crema); stroke-width: 2; }
  .brews { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .brew { display: grid; grid-template-columns: 70px 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .recipe { text-transform: none; letter-spacing: 0; margin-top: 2px; }
  .note { margin: 6px 0 0; color: var(--ink-soft); font-size: .95rem; }
  .sample { margin-left: 8px; border-color: var(--crema); color: var(--crema); }
  .beans { display: flex; gap: 4px; padding-top: 4px; }
  .beans span { width: 10px; height: 14px; border-radius: 50%; border: 1.5px solid var(--crema); }
  .beans span.on { background: var(--crema); }

  /* food */
  .food-big { display: flex; gap: clamp(24px, 6vw, 72px); margin: 28px 0; flex-wrap: wrap; }
  .food-big div { display: flex; flex-direction: column; }
  .food-big .num { font-size: clamp(2.6rem, 7vw, 4rem); color: var(--line-jkt); }
  .food-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 16px; }
  .bar-row { display: grid; grid-template-columns: 120px 1fr 36px; gap: 10px; align-items: center; margin: 10px 0; font-size: .92rem; }
  .track { height: 12px; background: var(--line); border-radius: 6px; overflow: hidden; }
  .fill { display: block; height: 100%; background: var(--line-jkt); border-radius: 6px; }
  .val { font-family: var(--font-mono); font-size: .85rem; text-align: right; }
  .rank { display: grid; grid-template-columns: 32px 1fr auto; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .nyc p { margin: 10px 0; color: var(--ink-soft); }
  .nyc .num { font-size: 1.6rem; color: var(--line-nyc); margin-right: 4px; }
  .favs { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 32px; }

  @media (max-width: 780px) {
    .brew-stats { grid-template-columns: 1fr 1fr; }
    .food-grid { grid-template-columns: 1fr; }
    .brew { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
